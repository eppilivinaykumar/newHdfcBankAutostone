insert_job: AST_SUB_CMD_4    job_type: cmd
description: "Sub BOX Command 4"
machine: localhost
condition: s(AST_SUB_CMD_2) AND s(AST_SUB_CMD_3)
owner: autosys@localhost
box_name: AST_SUB_BOX
group: AUTOSTONE_TEST
